# Copy to .env and fill in (never commit .env):
#   cp .env.example .env
#
# clawssh loads .env from the current working directory on startup.
# Variables already set in the shell take precedence (same as docker-compose).
# Optional: use another file from the shell only (not from inside .env):
#   CLAWSSH_DOTENV=configs/dev.env go run ./cmd/clawssh

# --- SSH gateway (required: password OR authorized keys) ---
CLAWSSH_PASSWORD=changeme
# CLAWSSH_AUTHORIZED_KEYS=/path/to/authorized_keys

CLAWSSH_ADDR=:2222
# CLAWSSH_HOST_KEY=host_key

# --- Intent engine: keyword (default) or llm ---
CLAWSSH_INTENT_ENGINE=keyword
# CLAWSSH_INTENT_ENGINE=llm

# --- LLM（仅当 CLAWSSH_INTENT_ENGINE=llm）---
# 方式 A — 官方 OpenAI：至少要有 OPENAI_API_KEY；可不写 CLAWSSH_LLM_PROVIDER（会自动选 openai）
# CLAWSSH_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# CLAWSSH_OPENAI_MODEL=gpt-4o-mini

# 方式 B — 国内/自建 OpenAI 兼容接口（必须三项齐全）：
# CLAWSSH_OPENAI_BASE_URL=https://xxx/v1
# CLAWSSH_OPENAI_MODEL=模型名
# CLAW_AI_API_KEY=或 OPENAI_API_KEY

# 方式 C — 其它预设：gemini / minimax / anthropic（需对应 KEY，见 internal/engine/llm_client.go）
# CLAWSSH_LLM_PROVIDER=gemini
# CLAW_AI_API_KEY=或 GOOGLE_API_KEY...

# --- Policy / environment ---
# CLAWSSH_ENV=development
# CLAWSSH_POLICIES=configs/policies.yaml

# --- Explorer (session context probes) ---
# CLAWSSH_EXPLORER_CONFIG=configs/explorer.yaml
# CLAWSSH_EXPLORER_PROBES=kernel,nginx_path,docker_path
# CLAWSSH_EXPLORER_TIMEOUT_SECONDS=5

# --- Streaming (only for high-cost actions) ---
# Comma-separated action allowlist. Empty uses defaults:
# install_package,service_control,tail_log,package_list
# CLAWSSH_STREAM_ACTIONS=tail_log,service_control

# --- Remote SSH defaults (for source=ssh_remote) ---
# You can use either private key or password auth.
# CLAWSSH_REMOTE_SSH_HOST=10.0.0.12
# CLAWSSH_REMOTE_SSH_USER=ubuntu
# CLAWSSH_REMOTE_SSH_PORT=22
# CLAWSSH_REMOTE_SSH_KEY_PATH=/home/you/.ssh/id_rsa
# CLAWSSH_REMOTE_SSH_PASSWORD=your-ssh-password

# --- Local knowledge base (SOP retrieval for LLM prompt enhancement) ---
# CLAWSSH_KNOWLEDGE_PATH=docs/ops

# --- Output summary (post-execution, best-effort) ---
# Enables a lightweight one-line summary for long outputs (e.g. top).
# CLAWSSH_SUMMARY_ENABLED=1
# CLAWSSH_SUMMARY_MIN_CHARS=800
# CLAWSSH_SUMMARY_TIMEOUT_SECONDS=8
# CLAWSSH_SUMMARY_MAX_INPUT_CHARS=3000
#
# Optional dedicated summary model (OpenAI-compatible). If any is set, all three must be set:
# CLAWSSH_SUMMARY_BASE_URL=https://api.minimaxi.com/v1
# CLAWSSH_SUMMARY_MODEL=MiniMax-M2.7
# CLAWSSH_SUMMARY_API_KEY=...
