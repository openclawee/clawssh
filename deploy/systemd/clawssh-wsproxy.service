[Unit]
Description=ClawSSH WebSocket Proxy (SSH over TLS)
Documentation=https://github.com/openclawee/clawssh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clawssh
Group=clawssh
WorkingDirectory=/opt/clawssh
EnvironmentFile=-/etc/clawssh/wsproxy.env
ExecStart=/usr/local/bin/clawssh-wsproxy
Restart=always
RestartSec=2s
TimeoutStopSec=20s
LimitNOFILE=1048576

# Bind :443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/etc/ssl /etc/letsencrypt /etc/clawssh

[Install]
WantedBy=multi-user.target
